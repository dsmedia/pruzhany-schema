@prefix pc: <https://pruzhany.org/ns/sourced-entities#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .

<https://pruzhany.org/ns/site-content> a owl:Ontology ;
  owl:versionInfo "0.1.0 proposed; unreleased" ;
  rdfs:comment "Proposed site-content application profile; terms await owner approval and do not alter the released sourced-entities profile." .

pc:subtype_wedding_greeting a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Wedding greeting"@en ; skos:definition "A greeting to a couple on their wedding."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_engagement_greeting a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Engagement greeting"@en ; skos:definition "A greeting on an engagement."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_birth_greeting a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Birth greeting"@en ; skos:definition "A greeting on the birth of a child."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_bar_mitzvah_greeting a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Bar mitzvah greeting"@en ; skos:definition "A greeting on a bar mitzvah."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_new_year_greeting a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "New Year greeting"@en ; skos:definition "A greeting for the New Year."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_departure_greeting a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Departure greeting"@en ; skos:definition "Good wishes on departure or settlement elsewhere."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_greeting a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Greeting"@en ; skos:definition "A greeting whose occasion is not specified by a narrower form."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_thanks a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Thanks"@en ; skos:definition "A public expression of thanks or acknowledgement."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_meeting_notice a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Meeting notice"@en ; skos:definition "A notice inviting people to a meeting."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_announcement a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Announcement"@en ; skos:definition "A public announcement without a narrower established form."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_appeal a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Appeal"@en ; skos:definition "A public request for support, contributions or participation."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_commercial_advertisement a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Commercial advertisement"@en ; skos:definition "An advertisement for goods, services or premises."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_condolence a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Condolence"@en ; skos:definition "An expression of sympathy to mourners."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_memorial_notice a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Memorial notice"@en ; skos:definition "A notice commemorating someone who has died."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_death_announcement a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Death announcement"@en ; skos:definition "An announcement of a death or funeral."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_editorial a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Editorial"@en ; skos:definition "An editorial statement by the newspaper."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_opinion a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Opinion"@en ; skos:definition "An argument or commentary expressing a view."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_letter a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Letter"@en ; skos:definition "A letter printed for readers, including letters to the editor."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_poem a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Poem"@en ; skos:definition "A composition in verse."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_sketch a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Sketch"@en ; skos:definition "A short literary sketch."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subtype_humour a skos:Concept, rico:DocumentaryFormType ; skos:prefLabel "Humour"@en ; skos:definition "A joke or short humorous composition."@en ; rdfs:comment "A local documentary form concept refines one Impresso type; the pinned ontologies do not enumerate this newspaper's forms." .
pc:subject_education a skos:Concept ; skos:prefLabel "Education"@en ; skos:definition "Education, schools and learning."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_culture a skos:Concept ; skos:prefLabel "Culture"@en ; skos:definition "Cultural activity and institutions."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_health a skos:Concept ; skos:prefLabel "Health"@en ; skos:definition "Health, medicine and hygiene."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_palestine a skos:Concept ; skos:prefLabel "Palestine"@en ; skos:definition "Life and developments in Palestine."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_jewish_world a skos:Concept ; skos:prefLabel "Jewish world"@en ; skos:definition "Jewish communities beyond the immediate locality."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_literature a skos:Concept ; skos:prefLabel "Literature"@en ; skos:definition "Literary works and literary life."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_sport a skos:Concept ; skos:prefLabel "Sport"@en ; skos:definition "Sport and sporting associations."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_economy a skos:Concept ; skos:prefLabel "Economy"@en ; skos:definition "Trade, work and economic conditions."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_community_affairs a skos:Concept ; skos:prefLabel "Community affairs"@en ; skos:definition "Local and regional communal life."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_zionism a skos:Concept ; skos:prefLabel "Zionism"@en ; skos:definition "Zionist activity, institutions and campaigns."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:subject_international_affairs a skos:Concept ; skos:prefLabel "International affairs"@en ; skos:definition "News of the wider world."@en ; rdfs:comment "A subject identifies what a content item is about; EHRI and RiC-O provide subject relations but no controlled identifier for this value." .
pc:title_type_printed a skos:Concept, rico:TitleType ; skos:prefLabel "Printed title"@en ; skos:definition "The printed words naming a content item or a section."@en ; rdfs:comment "Distinguishes words printed in the source from a supplied name; RiC-O defines TitleType but not this controlled value." .
pc:title_type_supplied a skos:Concept, rico:TitleType ; skos:prefLabel "Supplied title"@en ; skos:definition "An attributed English name pinned to the text it was made from."@en ; rdfs:comment "Distinguishes an attributed English name from printed words; RiC-O defines TitleType but not this controlled value." .
pc:site_display_permission a owl:NamedIndividual ; rdfs:comment "Neither EHRI nor RiC-O expresses the site's permission to display a relative under its living-person rule." .
pc:site_printed_address a owl:NamedIndividual ; rdfs:comment "Neither EHRI nor RiC-O defines an address combining a picture key, native pixel box and the words read there." .
pc:site_text_basis a owl:NamedIndividual ; rdfs:comment "EHRI and RiC-O source relations do not preserve the exact text and printed addresses used for a particular reading." .
pc:site_translation a owl:NamedIndividual ; rdfs:comment "Neither EHRI nor RiC-O has a term combining a translation with the exact source reading and its printed addresses." .
pc:site_authorship a owl:NamedIndividual ; rdfs:comment "RiC-O AuthorshipRelation describes an author relation, not the site's attribution value with person-or-model kind, writer and day." .
pc:site_mention a owl:NamedIndividual ; rdfs:comment "RiC-O subject relations do not express a named person's printed occurrence, address and role without asserting that the content item is about them." .
pc:site_mention_address_grain a owl:DatatypeProperty ; rdfs:label "Mention address grain"@en ; rdfs:range [ a rdfs:Datatype ; owl:oneOf ( "words" "regions" ) ] ; rdfs:comment "Neither EHRI 0.2.0 nor its RiC-O 1.1 version defines whether a mention locates name words or only whole printed regions." .
pc:site_shared_record a owl:NamedIndividual ; rdfs:comment "EHRI RecordSet groups record resources; it does not describe this application's single storage file combining identities, sourced facts and relations." .
pc:site_fact_subject a owl:NamedIndividual ; rdfs:comment "RiC-O relation endpoints do not specify the subject_id field attaching a production fact to a person, family or relation." .
pc:site_fact_representation a owl:NamedIndividual ; rdfs:comment "Neither EHRI nor RiC-O defines this site's distinction between a structured fact, retained prose and an image path." .
pc:site_standing a owl:NamedIndividual ; rdfs:comment "RiC-O relationState does not define this site's combinations of claim status and review or who set them." .
pc:site_site_copy a owl:NamedIndividual ; rdfs:comment "Neither EHRI nor RiC-O defines the rebuilt full-text copies, Unicode offsets and block references used by this site." .
pc:site_site_documents a owl:NamedIndividual ; rdfs:comment "EHRI RecordSet describes a collection, not this application's four-document value for validating joins." .

# Exact-byte bindings for the independent rico:Activity; the agent is ehri:Agent.
pc:site_checked_against_text a owl:NamedIndividual ; rdfs:comment "Neither pinned ontology defines this application-specific field-level digest binding." .
pc:site_reading_sha256 a owl:DatatypeProperty ; rdfs:label "reading_sha256"@en ; rdfs:comment "Neither pinned ontology specifies the digest of the exact reading in a field-level check." ; skos:definition "SHA-256 of the exact current reading UTF-8 bytes."@en .
pc:site_english_sha256 a owl:DatatypeProperty ; rdfs:label "english_sha256"@en ; rdfs:comment "Neither pinned ontology specifies the digest of the exact English field in a later check." ; skos:definition "SHA-256 of the exact English field UTF-8 bytes."@en .
pc:site_judgement_sha256 a owl:DatatypeProperty ; rdfs:label "judgement_sha256"@en ; rdfs:comment "Neither pinned ontology binds a field-level check to the exact retained judgement file bytes." ; skos:definition "SHA-256 of the exact retained judgement file bytes."@en .
