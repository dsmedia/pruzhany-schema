# Owner's batch (#16), released 1.2.0 on 2026-10-23.
pc:part_baby a owl:ObjectProperty ; rdfs:subPropertyOf rico:affectsOrAffected ; rdfs:domain rico:Event ; rdfs:range rico:Person ; rdfs:label "Baby"@en ; rdfs:comment "The birth happens to this person; RiC-O has no baby part." .
pc:part_parent a owl:ObjectProperty ; rdfs:subPropertyOf rico:hasOrHadParticipant ; rdfs:domain rico:Event ; rdfs:range rico:Person ; rdfs:label "Parent"@en ; rdfs:comment "A parent participates in a birth but is not the person born; RiC-O has no birth-parent part." .
pc:part_bride a owl:ObjectProperty ; rdfs:subPropertyOf rico:affectsOrAffected ; rdfs:domain rico:Event ; rdfs:range rico:Person ; rdfs:label "Bride"@en ; rdfs:comment "The engagement or wedding happens to the bride; RiC-O has no bride part." .
pc:part_groom a owl:ObjectProperty ; rdfs:subPropertyOf rico:affectsOrAffected ; rdfs:domain rico:Event ; rdfs:range rico:Person ; rdfs:label "Groom"@en ; rdfs:comment "The engagement or wedding happens to the groom; RiC-O has no groom part." .
pc:part_boy a owl:ObjectProperty ; rdfs:subPropertyOf rico:affectsOrAffected ; rdfs:domain rico:Event ; rdfs:range rico:Person ; rdfs:label "Boy"@en ; rdfs:comment "The bar mitzvah happens to this boy; RiC-O has no bar-mitzvah part." .
pc:part_deceased a owl:ObjectProperty ; rdfs:subPropertyOf rico:affectsOrAffected ; rdfs:domain rico:Event ; rdfs:range rico:Person ; rdfs:label "Deceased"@en ; rdfs:comment "The death happens to this person; RiC-O has no deceased part." .
pc:part_remembered a owl:ObjectProperty ; rdfs:subPropertyOf rico:affectsOrAffected ; rdfs:domain rico:Event ; rdfs:range rico:Person ; rdfs:label "Remembered"@en ; rdfs:comment "The commemoration concerns this person without asserting another death; RiC-O has no remembered part." .
pc:site_event_memorial a skos:Concept, rico:EventType ; rdfs:label "Memorial"@en ; rdfs:comment "RiC-O defines EventType without distinguishing the commemorations printed by this newspaper." .
pc:site_name_supplied a skos:Concept ; rdfs:label "Supplied description"@en ; rdfs:comment "RiC-O has AgentName but no name kind separating our supplied description from printed words." .
