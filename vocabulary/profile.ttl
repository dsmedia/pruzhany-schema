<https://pruzhany.org/ns/sourced-entities> a owl:Ontology ;
  owl:versionInfo "1.3.0 released" ;
  rdfs:comment "Production application profile; local categories are not ontology equivalence assertions. Namespace is an identifier, not a claim of hosted content." .

pc:fact_types_education a owl:NamedIndividual ; rdfs:label "education" ; rdfs:comment "TeachingRelation identifies teaching rather than establishing school attendance; retain attendance without asserting a teacher relationship." .
pc:fact_types_emigration a owl:NamedIndividual ; rdfs:label "emigration" ; rdfs:comment "RiC-O MigrationRelation concerns instantiations, not migration of people." .
pc:fact_types_survival a owl:NamedIndividual ; rdfs:label "survival" ; rdfs:comment "No dedicated pinned relation expresses evidence of being alive at a time." .
pc:fact_types_parenthood a owl:NamedIndividual ; owl:deprecated true ; rdfs:label "parenthood" ; rdfs:comment "Preserves an unnamed child without inventing a person node for a child relation." .
pc:fact_types_ghetto_role a owl:NamedIndividual ; rdfs:label "ghetto_role" ; rdfs:comment "No precise pinned counterpart for residual ghetto activities beyond membership or office." .
