    "$id": "https://pruzhany.org/ns/content_items",
    "$schema": "https://json-schema.org/draft/2019-09/schema",
    "additionalProperties": false,
    "description": "One issue's content items document: the issue's date, the vocabulary version its values are from, its content items and its printed sections.",
    "metamodel_version": "1.12.0",
    "properties": {
        "content_items": {
            "description": "The issue's content items.",
            "items": {
                "$ref": "#/$defs/ContentItem"
            },
            "type": "array"
        },
        "issue_date": {
            "description": "The issue's date, written YYYY-MM-DD.",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "type": "string"
        },
        "sections": {
            "description": "The issue's printed sections.",
            "items": {
                "$ref": "#/$defs/PrintedSection"
            },
            "type": "array"
        },
        "vocabulary_version": {
            "description": "The version of the site-content vocabulary whose values the document uses: one of the versions the current vocabulary accepts as compatible.",
            "pattern": "^(0\\.1\\.0|1\\.0\\.0|1\\.1\\.0)$(?![\\s\\S])",
            "type": "string"
        }
    },
    "required": [
        "issue_date",
        "vocabulary_version",
        "content_items",
        "sections"
    ],
    "title": "pruzhany_content_items",
    "type": "object",
    "version": null
}
