{
    "$defs": {
        "Attribution": {
            "additionalProperties": false,
            "description": "Who made or allowed something, on what day, with an optional note.",
            "properties": {
                "by": {
                    "description": "Who made it or allowed it: a person, a session or a program.",
                    "pattern": "\\S",
                    "type": "string"
                },
                "note": {
                    "description": "A note on how or why.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "on": {
                    "description": "The day it was made or allowed.",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                }
            },
            "required": [
                "by",
                "on"
            ],
            "title": "Attribution",
            "type": "object"
        },
        "Authorship": {
            "additionalProperties": false,
            "description": "Who wrote a supplied title, a translation or a check of one, a person or a model, and on which day.",
            "properties": {
                "by": {
                    "description": "Who made it or allowed it: a person, a session or a program.",
                    "pattern": "\\S",
                    "type": "string"
                },
                "kind": {
                    "$ref": "#/$defs/AuthorshipKind",
                    "description": "Whether a person or a model wrote it."
                },
                "note": {
                    "description": "A note on how or why.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "on": {
                    "description": "The day it was made or allowed.",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                }
            },
            "required": [
                "kind",
                "by",
                "on"
            ],
            "title": "Authorship",
            "type": "object"
        },
        "AuthorshipKind": {
            "description": "Whether a person or a program wrote a supplied title or a translation.",
            "enum": [
                "person",
                "model"
            ],
            "title": "AuthorshipKind",
            "type": "string"
        },
        "CitationRemarkKinds": {
            "description": "Citation remark kinds: the values of citation_remark_kinds in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "private_source_remark"
            ],
            "title": "CitationRemarkKinds",
            "type": "string"
        },
        "CitedTextBasis": {
            "additionalProperties": false,
            "description": "The exact source words of a citation or source title. The containing citation's locator or source description locates them; printed addresses are optional, and when supplied remain nonempty real image-and-box witnesses.",
            "properties": {
                "addresses": {
                    "description": "Where that text is printed, one address a line or patch.",
                    "items": {
                        "$ref": "#/$defs/PrintedAddress"
                    },
                    "minItems": 1,
                    "type": [
                        "array",
                        "null"
                    ]
                },
                "source_text": {
                    "description": "The text used, exactly, never normalised or replaced by a later reading.",
                    "type": "string"
                }
            },
            "required": [
                "source_text"
            ],
            "title": "CitedTextBasis",
            "type": "object"
        },
        "CitedTranslation": {
            "additionalProperties": false,
            "description": "English of a citation's quote or a source title, located by its containing record. Reuses Translation's English, attribution and check contract without requiring an image and box for a book page or archive record.",
            "properties": {
                "attribution": {
                    "$ref": "#/$defs/Authorship",
                    "description": "Who translated it, and on which day."
                },
                "based_on": {
                    "$ref": "#/$defs/CitedTextBasis",
                    "description": "The exact quote or title translated; source_text equals that original field, including whitespace and punctuation."
                },
                "checked_against": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/TranslationCheck"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "A later check of this translation against the reading, where one was made."
                },
                "language": {
                    "const": "en",
                    "description": "The translation's language, always English (en).",
                    "type": "string"
                },
                "text": {
                    "description": "The English text.",
                    "pattern": "\\S",
                    "type": "string"
                }
            },
            "required": [
                "text",
                "language",
                "based_on",
                "attribution"
            ],
            "title": "CitedTranslation",
            "type": "object"
        },
        "ClaimStatus": {
            "description": "Claim status: the values of claim_status in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "proposed",
                "accepted",
                "disputed",
                "rejected"
            ],
            "title": "ClaimStatus",
            "type": "string"
        },
        "CompatibilityEventTypes": {
            "description": "Compatibility event types: the values of compatibility_event_types in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "wedding",
                "birth",
                "death",
                "bar_mitzvah",
                "celebration",
                "community_event",
                "holocaust_event",
                "other"
            ],
            "title": "CompatibilityEventTypes",
            "type": "string"
        },
        "Confidence": {
            "description": "Confidence: the values of confidence in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "confirmed",
                "probable",
                "possible"
            ],
            "title": "Confidence",
            "type": "string"
        },
        "ContentItem": {
            "additionalProperties": false,
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "subtype": {
                                "enum": [
                                    "wedding_greeting",
                                    "engagement_greeting",
                                    "birth_greeting",
                                    "bar_mitzvah_greeting",
                                    "new_year_greeting",
                                    "departure_greeting",
                                    "greeting",
                                    "thanks",
                                    "meeting_notice",
                                    "announcement",
                                    "appeal",
                                    "commercial_advertisement"
                                ]
                            }
                        },
                        "required": [
                            "subtype"
                        ]
                    },
                    "then": {
                        "properties": {
                            "type": {
                                "const": "ad"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "subtype": {
                                "enum": [
                                    "condolence",
                                    "memorial_notice",
                                    "death_announcement"
                                ]
                            }
                        },
                        "required": [
                            "subtype"
                        ]
                    },
                    "then": {
                        "properties": {
                            "type": {
                                "const": "death_notice"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "subtype": {
                                "enum": [
                                    "editorial",
                                    "opinion",
                                    "letter",
                                    "poem",
                                    "sketch"
                                ]
                            }
                        },
                        "required": [
                            "subtype"
                        ]
                    },
                    "then": {
                        "properties": {
                            "type": {
                                "const": "article"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "subtype": {
                                "enum": [
                                    "humour"
                                ]
                            }
                        },
                        "required": [
                            "subtype"
                        ]
                    },
                    "then": {
                        "properties": {
                            "type": {
                                "const": "entertainment"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    }
                }
            ],
            "description": "One article, notice, greeting or advertisement of the issue: its kind, its titles, its text and English, the regions it is printed in and what it names.",
            "properties": {
                "block_breaks": {
                    "description": "Where each region's text begins in the full text, counted in Unicode code points.",
                    "items": {
                        "maximum": 9007199254740991,
                        "minimum": 0,
                        "type": "integer"
                    },
                    "type": "array"
                },
                "cross_references": {
                    "description": "Links from this content item to others in the issue.",
                    "items": {
                        "$ref": "#/$defs/CrossReference"
                    },
                    "type": "array"
                },
                "event_id": {
                    "description": "The life event the content item prints, by the event's id, where it prints one.",
                    "pattern": "\\S",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "full_text": {
                    "description": "The content item's printed text, a copy made for the site from the lines of its regions.",
                    "type": "string"
                },
                "id": {
                    "description": "The content item's id within the issue.",
                    "pattern": "\\S",
                    "type": "string"
                },
                "location_ids": {
                    "description": "The places the content item names, by their ids in the shared record.",
                    "items": {
                        "pattern": "\\S",
                        "type": "string"
                    },
                    "type": "array"
                },
                "organization_ids": {
                    "description": "The organisations the content item names, by their ids in the shared record.",
                    "items": {
                        "pattern": "\\S",
                        "type": "string"
                    },
                    "type": "array"
                },
                "page_blocks": {
                    "description": "The regions the content item is printed in, page by page, in reading order.",
                    "items": {
                        "$ref": "#/$defs/ContentItemBlockRef"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "printed_title": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/PrintedTitle"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The title as printed above the content item, where it has one."
                },
                "reading_status": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ReadingStatus"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "How far the text and the English have been checked; left out or null where it is not recorded."
                },
                "section_id": {
                    "description": "The printed section the content item stands under, by the section's id, where it stands under one.",
                    "pattern": "\\S",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "subject_ids": {
                    "description": "What the content item is about, as subjects of the site-content vocabulary.",
                    "items": {
                        "$ref": "#/$defs/Subjects"
                    },
                    "type": "array"
                },
                "subtype": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/ContentItemSubtypes"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The narrower form the content item takes within its kind, such as a wedding greeting within advertisements, where one is known."
                },
                "supplied_title": {
                    "$ref": "#/$defs/SuppliedTitle",
                    "description": "A title in English supplied for the content item."
                },
                "translation": {
                    "anyOf": [
                        {
                            "$ref": "#/$defs/Translation"
                        },
                        {
                            "type": "null"
                        }
                    ],
                    "description": "The content item's text in English, where it has been translated."
                },
                "type": {
                    "$ref": "#/$defs/ImpressoTypes",
                    "description": "The content item's kind, one of Impresso's content item types."
                }
            },
            "required": [
                "id",
                "type",
                "supplied_title",
                "subject_ids",
                "full_text",
                "block_breaks",
                "page_blocks",
                "location_ids",
                "organization_ids",
                "cross_references"
            ],
            "title": "ContentItem",
            "type": "object"
        },
        "ContentItemBlockRef": {
            "additionalProperties": false,
            "description": "The regions of one page that a content item or a section heading covers, in reading order.",
            "properties": {
                "block_ids": {
                    "description": "The regions on that page, by their ids in the pages document, in reading order.",
                    "items": {
                        "pattern": "\\S",
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "page_id": {
                    "description": "The page, by its id in the pages document.",
                    "pattern": "\\S",
                    "type": "string"
                }
            },
            "required": [
                "page_id",
                "block_ids"
            ],
            "title": "ContentItemBlockRef",
            "type": "object"
        },
        "ContentItemSubtypes": {
            "description": "Content item subtypes: the values of content_item_subtypes in vocabulary/site-content.json, version 1.1.0.",
            "enum": [
                "wedding_greeting",
                "engagement_greeting",
                "birth_greeting",
                "bar_mitzvah_greeting",
                "new_year_greeting",
                "departure_greeting",
                "greeting",
                "thanks",
                "meeting_notice",
                "announcement",
                "appeal",
                "commercial_advertisement",
                "condolence",
                "memorial_notice",
                "death_announcement",
                "editorial",
                "opinion",
                "letter",
                "poem",
                "sketch",
                "humour"
            ],
            "title": "ContentItemSubtypes",
            "type": "string"
        },
        "ContentItemsData": {
            "additionalProperties": false,
            "description": "One issue's content items document: the issue's date, the vocabulary version its values are from, its content items and its printed sections.",
            "properties": {
                "content_items": {
                    "description": "The issue's content items.",
                    "items": {
                        "$ref": "#/$defs/ContentItem"
                    },
                    "type": "array"
                },
                "issue_date": {
                    "description": "The issue's date, written YYYY-MM-DD.",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                },
                "sections": {
                    "description": "The issue's printed sections.",
                    "items": {
                        "$ref": "#/$defs/PrintedSection"
                    },
                    "type": "array"
                },
                "vocabulary_version": {
                    "description": "The version of the site-content vocabulary whose values the document uses: one of the versions the current vocabulary accepts as compatible.",
                    "pattern": "^(0\\.1\\.0|1\\.0\\.0|1\\.1\\.0)$(?![\\s\\S])",
                    "type": "string"
                }
            },
            "required": [
                "issue_date",
                "vocabulary_version",
                "content_items",
                "sections"
            ],
            "title": "ContentItemsData",
            "type": "object"
        },
        "ContentUnitRoles": {
            "description": "Content unit roles: the values of content_unit_roles in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "primary_announcement",
                "congratulation",
                "condolence",
                "mention",
                "advertisement"
            ],
            "title": "ContentUnitRoles",
            "type": "string"
        },
        "CrossReference": {
            "additionalProperties": false,
            "description": "A link from one content item to another in the same issue, with how sure it is and why.",
            "properties": {
                "confidence": {
                    "description": "How sure the link is, from 0 to 1.",
                    "type": "number"
                },
                "evidence": {
                    "description": "What shows the link, in words.",
                    "type": "string"
                },
                "relationship": {
                    "description": "What kind of link it is, in words.",
                    "type": "string"
                },
                "target_id": {
                    "description": "The id of the content item linked to.",
                    "type": "string"
                }
            },
            "required": [
                "target_id",
                "confidence",
                "relationship",
                "evidence"
            ],
            "title": "CrossReference",
            "type": "object"
        },
        "EnglishCheck": {
            "additionalProperties": false,
            "description": "A later, separate check of one English field against one exact reading of the printed text, bound to both and to the judgement kept by their digests.",
            "properties": {
                "attribution": {
                    "$ref": "#/$defs/Authorship",
                    "description": "Who checked it, and on which day."
                },
                "english_sha256": {
                    "description": "The SHA-256 digest of the checked English field's exact UTF-8 bytes.",
                    "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
                    "type": "string"
                },
                "judgement_id": {
                    "description": "The kept judgement, by an id without spaces followed by the field it judged, :title or :text.",
                    "pattern": "^[^\\s\\u0085\\uFEFF]+:(title|text)$(?![\\s\\S])",
                    "type": "string"
                },
                "judgement_sha256": {
                    "description": "The SHA-256 digest of the kept judgement file's exact bytes.",
                    "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
                    "type": "string"
                },
                "reading_id": {
                    "description": "The reading of the printed text that the English was checked against.",
                    "pattern": "\\S",
                    "type": "string"
                },
                "reading_sha256": {
                    "description": "The SHA-256 digest of that reading's exact UTF-8 bytes.",
                    "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
                    "type": "string"
                }
            },
            "required": [
                "reading_id",
                "reading_sha256",
                "english_sha256",
                "judgement_id",
                "judgement_sha256",
                "attribution"
            ],
            "title": "EnglishCheck",
            "type": "object"
        },
        "EventParts": {
            "description": "Event parts: the values of event_parts in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "baby",
                "parent",
                "bride",
                "groom",
                "boy",
                "deceased",
                "remembered"
            ],
            "title": "EventParts",
            "type": "string"
        },
        "EventTypes": {
            "description": "Event types: the values of event_types in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "engagement",
                "wedding",
                "birth",
                "death",
                "bar_mitzvah",
                "celebration",
                "community_event",
                "holocaust_event",
                "other",
                "memorial"
            ],
            "title": "EventTypes",
            "type": "string"
        },
        "ExternalSourceTypes": {
            "description": "External source types: the values of external_source_types in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "arolsen_archives",
                "familysearch",
                "findagrave",
                "geni",
                "jewishgen",
                "jri_poland",
                "wikipedia",
                "yad_vashem"
            ],
            "title": "ExternalSourceTypes",
            "type": "string"
        },
        "FactTypes": {
            "description": "Fact types: the values of fact_types in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "birth",
                "death",
                "residence",
                "occupation",
                "office",
                "membership",
                "education",
                "emigration",
                "survival",
                "parenthood",
                "ghetto_role",
                "partisan_service",
                "deportation",
                "burial",
                "commemoration",
                "event_participation",
                "other",
                "kinship"
            ],
            "title": "FactTypes",
            "type": "string"
        },
        "FateOutcomes": {
            "description": "Fate outcomes: the values of fate_outcomes in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "unknown",
                "perished",
                "survived",
                "died_before",
                "not_applicable"
            ],
            "title": "FateOutcomes",
            "type": "string"
        },
        "Gender": {
            "description": "Gender: the values of gender in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "male",
                "female",
                "unknown"
            ],
            "title": "Gender",
            "type": "string"
        },
        "HolocaustFateTypes": {
            "description": "Holocaust fate types: the values of holocaust_fate_types in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "unknown",
                "perished",
                "likely_perished",
                "survived",
                "likely_survived",
                "died_before",
                "not_applicable"
            ],
            "title": "HolocaustFateTypes",
            "type": "string"
        },
        "IdentifierTypes": {
            "description": "Identifier types approved in ADR 0001 and linked-data ticket 03.",
            "enum": [
                "old_identifier"
            ],
            "title": "IdentifierTypes",
            "type": "string"
        },
        "ImpressoTypes": {
            "description": "Impresso types: the content-item types of Impresso as vocabulary/site-content.json, version 1.1.0, lists them in impresso_types. Impresso defines them in a JSON Schema, not an ontology, so they carry no meaning here.",
            "enum": [
                "article",
                "ad",
                "image",
                "table",
                "death_notice",
                "weather",
                "page",
                "radio_bulletin",
                "radio_broadcast_episode",
                "chronicle",
                "chapter",
                "discussion",
                "entertainment"
            ],
            "title": "ImpressoTypes",
            "type": "string"
        },
        "LifeEventTypes": {
            "description": "Life event types: the values of life_event_types in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "wedding",
                "birth",
                "death",
                "bar_mitzvah",
                "celebration",
                "community_event",
                "other"
            ],
            "title": "LifeEventTypes",
            "type": "string"
        },
        "LocationTypes": {
            "description": "Location types: the values of location_types in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "city",
                "town",
                "village",
                "shtetl",
                "street",
                "address",
                "landmark",
                "country",
                "region",
                "district",
                "ghetto",
                "camp",
                "massacre_site",
                "deportation_point",
                "forest"
            ],
            "title": "LocationTypes",
            "type": "string"
        },
        "MentionRoles": {
            "description": "Mention roles: the values of mention_roles in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "subject",
                "deceased",
                "honoree",
                "signer",
                "mourner",
                "advertiser",
                "author",
                "office_holder",
                "donor",
                "named",
                "betrothed",
                "parent"
            ],
            "title": "MentionRoles",
            "type": "string"
        },
        "NameKinds": {
            "description": "Name kinds: the values of name_kinds in vocabulary/sourced-entities.json, version 1.3.0.",
            "enum": [
                "printed",
                "birth",
                "married",
                "later",
                "nickname",
                "alias",
                "religious",
                "spelling",
                "supplied"
            ],
            "title": "NameKinds",
            "type": "string"
        },
        "PrintedAddress": {
            "additionalProperties": false,
            "description": "Where some printed words stand: the page picture, a box on it in the picture's own pixels, and the words read in that box.",
            "properties": {
                "bbox": {
                    "description": "The box on the picture: left, top, width and height, in the picture's pixels.",
                    "items": {
                        "minimum": 0,
                        "type": "number"
                    },
                    "maxItems": 4,
                    "minItems": 4,
                    "type": "array"
                },
                "image_uri": {
                    "description": "The page picture the box is on, by its name or address.",
                    "pattern": "\\S",
                    "type": "string"
                },
                "text": {
                    "description": "The words read in the box, exactly as read; empty for a patch with no readable line.",
                    "type": "string"
                }
            },
            "required": [
                "image_uri",
                "bbox",
                "text"
            ],
            "title": "PrintedAddress",
            "type": "object"
        },
        "PrintedSection": {
            "additionalProperties": false,
            "description": "A printed heading and the content items that stand beneath it, such as the title \"What is heard in town?\" over the town's news.",
            "properties": {
                "content_item_ids": {
                    "description": "The content items beneath the heading, by their ids.",
                    "items": {
                        "pattern": "\\S",
                        "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "heading_blocks": {
                    "description": "The regions the heading is printed in, page by page.",
                    "items": {
                        "$ref": "#/$defs/ContentItemBlockRef"
                    },
                    "minItems": 1,
                    "type": "array"
                },
                "id": {
                    "description": "The section's id within the issue.",
