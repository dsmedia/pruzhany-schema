                    "type": "string"
                },
                "judgement_sha256": {
                    "description": "The SHA-256 digest of the kept judgement file's exact bytes.",
                    "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
                    "type": "string"
                },
                "reading_id": {
                    "description": "The reading of the printed text that the English was checked against.",
                    "pattern": "\\S",
                    "type": "string"
                },
                "reading_sha256": {
                    "description": "The SHA-256 digest of that reading's exact UTF-8 bytes.",
                    "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
                    "type": "string"
                }
            },
            "required": [
                "reading_id",
                "reading_sha256",
                "english_sha256",
                "judgement_id",
                "judgement_sha256",
                "attribution"
            ],
            "title": "TitleCheck",
            "type": "object"
        },
