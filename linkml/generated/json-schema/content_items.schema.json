        "TitleCheck": {
            "additionalProperties": false,
            "description": "A check of a supplied title's English.",
            "properties": {
                "attribution": {
                    "$ref": "#/$defs/Authorship",
                    "description": "Who checked it, and on which day."
                },
                "english_sha256": {
