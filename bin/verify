#!/usr/bin/env bash
# bin/verify — the one verify entry point for pruzhany-schema; run it locally
# before pushing. CI runs it verbatim, split across two workflows so the
# history is scanned once: gitleaks.yml runs `bin/verify scan` (every push to
# every branch) and ci.yml runs `bin/verify zod pydantic contract pilot standards vocabulary entities linkml`.
#
#   bin/verify            run every step below
#   bin/verify <step>...  run only the named steps (scan, zod, pydantic, contract, pilot, standards, vocabulary, entities, linkml)
#
# Steps (self-contained by default; LinkML also checks available sibling data and catalogs):
#   scan      gitleaks over the full git history, secrets redacted.
#   zod       bun install --frozen-lockfile (package.json pins the same zod, prettier,
#             vitest and typescript versions as pruzhany-svelte's bun.lock),
#             then the zod/*.test.ts suite under vitest and a strict tsc
#             typecheck of zod/.
#   pydantic  loads the pydantic/ package (under a non-shadowing name) with
#             the pinned pydantic version, and generates the JSON Schema of
#             every model it defines.
#   contract  the Zod<->Pydantic lockstep and mapped LinkML agreement: fields,
#             requiredness and enum values (tests/contract/; moved here from pruzhany-press
#             when that repository was retired on 2026-10-22).
#   entities  checks sourced-entity parity in the current SiteArchive carrier and its JSON Schema.
#   vocabulary validates production vocabulary, history, crosswalk and generated contracts.
#   standards checks pinned RiC-O/EHRI terms, local mappings and the fetched IIIF schema.
#             An empty IIIF cache requires network; download/hash failures stop the check.
#   pilot     checks generated vocabulary/artifacts and exercises the isolated
#             issue-14 pilot, including parsed RDF and privacy/reversal cases,
#             the isolated TS parity test under bun and a non-UTF-8 locale check.
#   linkml    the LinkML definition (linkml/README.md), in an environment of its own
#             installed from linkml/requirements.lock with every hash required:
#             `linkml lint` on every schema file, the house lint (linkml/lint.py),
#             every generated file made again and compared byte for byte with
#             linkml/generated/, the canaries that fail when LinkML's behaviour
#             changes, then the tests (including the pilot against both pinned
#             EHRI person shapes, using PyShEx/pySHACL in this hashed lock).
#
# Tools: bash, git, bun, uv, gitleaks (versions pinned in mise.toml; CI
# installs the same ones).
set -euo pipefail

cd "$(dirname "$0")/.."

# The Python and pydantic every Python step runs with.
PYDANTIC_VERSION="2.13.5"
PYTHON_VERSION="3.11"

step_scan() {
	gitleaks git . --redact --exit-code 1 --no-banner
}

step_zod() {
	bun install --frozen-lockfile
	# --dir keeps vitest from collecting tests inside .claude/worktrees/.
	bun x vitest run --dir zod
	bun x tsc --noEmit --strict --target es2022 --module esnext \
		--moduleResolution bundler --resolveJsonModule --skipLibCheck zod/*.ts
	echo "tsc: zod/ typechecks"
	# pruzhany-svelte runs `prettier --check src/`, and src/lib/schemas is this zod/:
	# the same prettier version and options, so an unformatted file fails here first.
	bun x prettier --check zod tests pilots/sourced-entities/*.ts
}

step_pydantic() {
	uv run --no-project --python "$PYTHON_VERSION" \
		--with "pydantic==$PYDANTIC_VERSION" python -P - <<'PY'
"""Load pydantic/ and build every model's JSON Schema.

The tree is a package literally named `pydantic`, which would shadow the
library if the repo root were on sys.path (hence `python -P`), so it is
loaded under another name, the same way tests/contract/check_lockstep.py does.
"""

import importlib.util
import inspect
import sys
from pathlib import Path

from pydantic import BaseModel

PKG = "pruzhany_schema_pydantic"
root = Path("pydantic")
spec = importlib.util.spec_from_file_location(
    PKG, root / "__init__.py", submodule_search_locations=[str(root)]
)
package = importlib.util.module_from_spec(spec)
sys.modules[PKG] = package
spec.loader.exec_module(package)

count = 0
for path in sorted(root.rglob("*.py")):
    if path.name == "__init__.py":
        continue
    relative_module = '.'.join(path.relative_to(root).with_suffix('').parts)
    module = importlib.import_module(f"{PKG}.{relative_module}")
    for _, obj in inspect.getmembers(module, inspect.isclass):
        if issubclass(obj, BaseModel) and obj.__module__ == module.__name__:
            obj.model_json_schema()
            count += 1
if count == 0:
    sys.exit("pydantic: no models found")
print(f"pydantic: {count} models load and emit JSON Schema")
PY
}

step_vocabulary() {
	bun install --frozen-lockfile
	python3 -I -B vocabulary/check.py
	python3 -I -B vocabulary/generate.py --check
	python3 -I -B -m unittest discover -s vocabulary -p 'test_*.py'
}

step_standards() {
	uv run --no-project --python "$PYTHON_VERSION" python -P standards/fetch_iiif.py
	# Same jsonschema version as linkml/requirements.lock; validation API read 31 October 2026:
	# https://python-jsonschema.readthedocs.io/en/v4.26.0/validate/
	uv run --no-project --python "$PYTHON_VERSION" --with "jsonschema==4.26.0" \
		python -P -m unittest discover -s standards -p 'test_*.py'
	uv run --no-project --python "$PYTHON_VERSION" python -P standards/check_alignment.py
}

step_pilot() {
	bun install --frozen-lockfile # the generators format their TypeScript with prettier
	uv run --no-project --python "$PYTHON_VERSION" \
		--with "pydantic==$PYDANTIC_VERSION" --with "rdflib==7.1.4" \
		python -P pilots/sourced-entities/generate_vocabulary.py --check
	uv run --no-project --python "$PYTHON_VERSION" \
		--with "pydantic==$PYDANTIC_VERSION" --with "rdflib==7.1.4" \
		python -P pilots/sourced-entities/build.py --check
	uv run --no-project --python "$PYTHON_VERSION" \
		--with "pydantic==$PYDANTIC_VERSION" --with "rdflib==7.1.4" \
		python -P -m unittest discover -s pilots/sourced-entities -p 'test_*.py'
	local fixtures
	fixtures=$(mktemp)
	trap 'rm -f "$fixtures"' RETURN
	PYTHONIOENCODING=cp1252 PYTHONUTF8=0 LANG=C LC_ALL=C \
		uv run --no-project --python "$PYTHON_VERSION" --with "pydantic==$PYDANTIC_VERSION" \
		python -P pilots/sourced-entities/build.py --check
	PYTHONIOENCODING=cp1252 PYTHONUTF8=0 LANG=C LC_ALL=C \
		uv run --no-project --python "$PYTHON_VERSION" --with "pydantic==$PYDANTIC_VERSION" \
		python -P pilots/sourced-entities/contract_cases.py > "$fixtures"
	bun install --frozen-lockfile
	PILOT_CONTRACT_FIXTURES="$fixtures" bun x vitest run --dir pilots/sourced-entities
}

step_entities() {
	local fixtures schema
	fixtures=$(mktemp)
	schema=$(mktemp)
	trap 'rm -f "$fixtures" "$schema"' RETURN
	uv run --no-project --python "$PYTHON_VERSION" --with "pydantic==$PYDANTIC_VERSION" \
		python -P tests/sourced-entities/contract_cases.py > "$fixtures"
	bun install --frozen-lockfile
	ENTITIES_CONTRACT_FIXTURES="$fixtures" bun x vitest run --dir tests/sourced-entities
	bun -e "import {z} from 'zod/v4'; import {SiteArchiveSchema} from './zod/site-issue.schema'; console.log(JSON.stringify(z.toJSONSchema(SiteArchiveSchema)))" > "$schema"
	uv run --no-project --python "$PYTHON_VERSION" --with 'jsonschema==4.26.0' \
		python -P tests/sourced-entities/check_json_schema.py "$schema" "$fixtures"
	# Current site and sourced-entity contracts must still pass together.
	bun x vitest run --dir zod
}

step_contract() {
	bun install --frozen-lockfile
	uv run --no-project --python "$PYTHON_VERSION" --with "pydantic==$PYDANTIC_VERSION" \
		python -P tests/contract/check_lockstep.py
	uv run --no-project --python "$PYTHON_VERSION" --with "pydantic==$PYDANTIC_VERSION" \
		python -P -m unittest discover -s tests/contract -p 'test_linkml*.py'
}

step_linkml() {
	# LinkML 1.12.1 and everything it brings, installed from linkml/requirements.lock with
	# every hash required (and setuptools, which builds the three packages PyPI holds only as
	# source, from linkml/build-constraints.txt, also by hash), into a fresh environment in a
	# temporary folder; uv's cache makes that a fraction of a second. It is not the other
	# Python steps' environment: linkml 1.12.1 needs pydantic 2.13.5 or later, and they pin
	# PYDANTIC_VERSION. `uv run --with-requirements` is not used because it installed a lock
	# with a planted wrong hash without complaint (uv 0.11.32, 28 October 2026).
	local env py
	env=$(mktemp -d)
	trap "rm -rf '$env'" RETURN EXIT
	uv venv --quiet --python "$PYTHON_VERSION" "$env"
	py="$env/bin/python"
	[ -x "$py" ] || py="$env/Scripts/python.exe" # a Windows environment
	uv pip sync --quiet --python "$py" --require-hashes \
		--build-constraints linkml/build-constraints.txt linkml/requirements.lock
	bun install --frozen-lockfile # the tests export the Zod shapes with bun
	bun x prettier --check linkml/*.ts linkml/*.json
	# `linkml lint` (the module behind it, so the same call works where the environment
	# keeps its programs in Scripts/), then the house lint.
	"$py" -I -m linkml.linter.cli --config linkml/linkml-lint.yaml linkml/schema
	"$py" -I -B linkml/lint.py
	"$py" -I -B linkml/generate.py --check
	"$py" -I -B -m unittest discover -s linkml/tests -p 'canary_*.py'
	"$py" -I -B -m unittest discover -s linkml/tests -p 'test_*.py'
}

ALL_STEPS=(scan zod pydantic contract pilot standards vocabulary entities linkml)
steps=("$@")
[ ${#steps[@]} -eq 0 ] && steps=("${ALL_STEPS[@]}")

for step in "${steps[@]}"; do
	case "$step" in
	scan | zod | pydantic | contract | pilot | standards | vocabulary | entities | linkml) ;;
	*)
		echo "bin/verify: unknown step '$step' (expected: ${ALL_STEPS[*]})" >&2
		exit 2
		;;
	esac
done

for step in "${steps[@]}"; do
	echo "==> $step"
	"step_$step"
done
echo "==> verify passed: ${steps[*]}"
