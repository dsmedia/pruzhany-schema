#!/usr/bin/env bash
# bin/verify — the one verify entry point for pruzhany-schema; run it locally
# before pushing. CI runs it verbatim, split across two workflows so the
# history is scanned once: gitleaks.yml runs `bin/verify scan` (every push to
# every branch) and ci.yml runs `bin/verify zod pydantic pilot standards vocabulary entities`.
#
#   bin/verify            run every step below
#   bin/verify <step>...  run only the named steps (scan, zod, pydantic, pilot, standards, vocabulary, entities)
#
# Steps (all self-contained: nothing outside this checkout is read):
#   scan      gitleaks over the full git history, secrets redacted.
#   zod       bun install --frozen-lockfile (package.json pins the same zod, prettier,
#             vitest and typescript versions as pruzhany-svelte's bun.lock),
#             then the zod/*.test.ts suite under vitest and a strict tsc
#             typecheck of zod/.
#   pydantic  loads the pydantic/ package (under a non-shadowing name) with
#             the pinned pydantic version, and generates the JSON Schema of
#             every model it defines.
#   contract  the Zod<->Pydantic lockstep: every twin's field names and enum
#             values agree (tests/contract/; moved here from pruzhany-press
#             when that repository was retired on 2026-10-22).
#   entities  checks shared production sourced-entity parity and JSON Schema.
#   vocabulary validates production vocabulary, history, crosswalk and generated contracts.
#   standards checks pinned RiC-O/EHRI terms and explicit local mappings.
#   pilot     checks generated vocabulary/artifacts and exercises the isolated
#             issue-14 pilot, including parsed RDF and privacy/reversal cases,
#             the isolated TS parity test under bun and a non-UTF-8 locale check.
#
# Tools: bash, git, bun, uv, gitleaks (versions pinned in mise.toml; CI
# installs the same ones).
set -euo pipefail

cd "$(dirname "$0")/.."

# The Python and pydantic every Python step runs with.
PYDANTIC_VERSION="2.12.5"
PYTHON_VERSION="3.11"

step_scan() {
	gitleaks git . --redact --exit-code 1 --no-banner
}

step_zod() {
	bun install --frozen-lockfile
	# --dir keeps vitest from collecting tests inside .claude/worktrees/.
	bun x vitest run --dir zod
	bun x tsc --noEmit --strict --target es2022 --module esnext \
		--moduleResolution bundler --skipLibCheck zod/*.ts
	echo "tsc: zod/ typechecks"
	# pruzhany-svelte runs `prettier --check src/`, and src/lib/schemas is this zod/:
	# the same prettier version and options, so an unformatted file fails here first.
	bun x prettier --check zod tests pilots/sourced-entities/*.ts
}

step_pydantic() {
	uv run --no-project --python "$PYTHON_VERSION" \
		--with "pydantic==$PYDANTIC_VERSION" python -P - <<'PY'
"""Load pydantic/ and build every model's JSON Schema.

The tree is a package literally named `pydantic`, which would shadow the
library if the repo root were on sys.path (hence `python -P`), so it is
loaded under another name, the same way tests/contract/check_lockstep.py does.
"""

import importlib.util
import inspect
import sys
from pathlib import Path

from pydantic import BaseModel

PKG = "pruzhany_schema_pydantic"
root = Path("pydantic")
spec = importlib.util.spec_from_file_location(
    PKG, root / "__init__.py", submodule_search_locations=[str(root)]
)
package = importlib.util.module_from_spec(spec)
sys.modules[PKG] = package
spec.loader.exec_module(package)

count = 0
for path in sorted(root.glob("*.py")):
    if path.name == "__init__.py":
        continue
    module = importlib.import_module(f"{PKG}.{path.stem}")
    for _, obj in inspect.getmembers(module, inspect.isclass):
        if issubclass(obj, BaseModel) and obj.__module__ == module.__name__:
            obj.model_json_schema()
            count += 1
if count == 0:
    sys.exit("pydantic: no models found")
print(f"pydantic: {count} models load and emit JSON Schema")
PY
}

step_vocabulary() {
	bun install --frozen-lockfile
	python3 -I -B vocabulary/check.py
	python3 -I -B vocabulary/generate.py --check
	python3 -I -B -m unittest discover -s vocabulary -p 'test_*.py'
}

step_standards() {
	uv run --no-project --python "$PYTHON_VERSION" python -P -m unittest discover -s standards -p 'test_*.py'
	uv run --no-project --python "$PYTHON_VERSION" python -P standards/check_alignment.py
}

step_pilot() {
	bun install --frozen-lockfile # the generators format their TypeScript with prettier
	uv run --no-project --python "$PYTHON_VERSION" \
		--with "pydantic==$PYDANTIC_VERSION" --with "rdflib==7.1.4" \
		python -P pilots/sourced-entities/generate_vocabulary.py --check
	uv run --no-project --python "$PYTHON_VERSION" \
		--with "pydantic==$PYDANTIC_VERSION" --with "rdflib==7.1.4" \
		python -P pilots/sourced-entities/build.py --check
	uv run --no-project --python "$PYTHON_VERSION" \
		--with "pydantic==$PYDANTIC_VERSION" --with "rdflib==7.1.4" \
		python -P -m unittest discover -s pilots/sourced-entities -p 'test_*.py'
	local fixtures
	fixtures=$(mktemp)
	trap 'rm -f "$fixtures"' RETURN
	PYTHONIOENCODING=cp1252 PYTHONUTF8=0 LANG=C LC_ALL=C \
		uv run --no-project --python "$PYTHON_VERSION" --with "pydantic==$PYDANTIC_VERSION" \
		python -P pilots/sourced-entities/build.py --check
	PYTHONIOENCODING=cp1252 PYTHONUTF8=0 LANG=C LC_ALL=C \
		uv run --no-project --python "$PYTHON_VERSION" --with "pydantic==$PYDANTIC_VERSION" \
		python -P pilots/sourced-entities/contract_cases.py > "$fixtures"
	bun install --frozen-lockfile
	PILOT_CONTRACT_FIXTURES="$fixtures" bun x vitest run --dir pilots/sourced-entities
}

step_entities() {
	local fixtures schema
	fixtures=$(mktemp)
	schema=$(mktemp)
	trap 'rm -f "$fixtures" "$schema"' RETURN
	uv run --no-project --python "$PYTHON_VERSION" --with "pydantic==$PYDANTIC_VERSION" \
		python -P tests/sourced-entities/contract_cases.py > "$fixtures"
	bun install --frozen-lockfile
	ENTITIES_CONTRACT_FIXTURES="$fixtures" bun x vitest run --dir tests/sourced-entities
	bun -e "import {z} from 'zod/v4'; import {EnrichmentDataSchema} from './zod/enrichment.schema'; console.log(JSON.stringify(z.toJSONSchema(EnrichmentDataSchema)))" > "$schema"
	uv run --no-project --python "$PYTHON_VERSION" --with 'jsonschema==4.26.0' \
		python -P tests/sourced-entities/check_json_schema.py "$schema" "$fixtures"
	# Existing production tests remain unchanged and must pass with the attachments.
	bun x vitest run --dir zod
}

step_contract() {
	bun install --frozen-lockfile
	uv run --no-project --python "$PYTHON_VERSION" --with "pydantic==$PYDANTIC_VERSION" \
		python -P tests/contract/check_lockstep.py
}

ALL_STEPS=(scan zod pydantic contract pilot standards vocabulary entities)
steps=("$@")
[ ${#steps[@]} -eq 0 ] && steps=("${ALL_STEPS[@]}")

for step in "${steps[@]}"; do
	case "$step" in
	scan | zod | pydantic | contract | pilot | standards | vocabulary | entities) ;;
	*)
		echo "bin/verify: unknown step '$step' (expected: ${ALL_STEPS[*]})" >&2
		exit 2
		;;
	esac
done

for step in "${steps[@]}"; do
	echo "==> $step"
	"step_$step"
done
echo "==> verify passed: ${steps[*]}"
